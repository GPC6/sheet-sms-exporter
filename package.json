{
  "name": "sheet-sms-exporter",
  "productName": "Sheet SMS Exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Google Sheets to SMS recipient Excel files",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run check && electron-builder --publish never"
  },
  "dependencies": {
    "google-auth-library": "11.3.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "app.sheet-sms-exporter.desktop",
    "productName": "Sheet SMS Exporter",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": { "target": ["zip", "dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis", "zip"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
